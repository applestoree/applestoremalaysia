{
  "design_system": {
    "name": "Apple Store Malaysia",
    "version": "1.0",
    "platform": "mobile-only",
    "viewport": {
      "max_width": "500px",
      "width": "100%",
      "height": "100vh",
      "desktop_behavior": "centered-mobile-container"
    },
    "font": {
      "family": "Nunito Sans",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    },
    "colors": {
      "background": "#FFFFFF",
      "surface": "#F5F5F7",
      "text": "#1D1D1F",
      "text_secondary": "#6E6E73",
      "border": "#EEEEEE",
      "primary": "#0071E3",
      "danger": "#B00020",
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px"
    },
    "radius": {
      "sm": "8px",
      "md": "10px",
      "lg": "14px",
      "xl": "16px",
      "2xl": "18px",
      "pill": "999px"
    },
    "layout": {
      "app": {
        "width": "100%",
        "max_width": "500px",
        "height": "100vh"
      },
      "header": {
        "height": "auto",
        "padding": "16px 20px"
      },
      "main": {
        "padding": "20px",
        "scroll": "vertical"
      },
      "bottom_nav": {
        "position": "bottom",
        "padding": "10px 8px"
      }
    },
    "typography": {
      "h1": {
        "font_size": "28px",
        "font_weight": 600,
        "line_height": "1.2"
      },
      "h2": {
        "font_size": "22px",
        "font_weight": 600,
        "line_height": "1.3"
      },
      "section_title": {
        "font_size": "18px",
        "font_weight": 600,
        "line_height": "1.3"
      },
      "body": {
        "font_size": "16px",
        "font_weight": 400,
        "line_height": "1.5"
      },
      "caption": {
        "font_size": "14px",
        "font_weight": 400,
        "line_height": "1.4"
      },
      "button": {
        "font_size": "16px",
        "font_weight": 600
      }
    },
    "components": {
      "Header": {
        "background": "#FFFFFF",
        "border_bottom": "1px solid #EEEEEE",
        "padding": "16px 20px"
      },
      "Hero": {
        "background": "#F5F5F7",
        "border_radius": "16px",
        "padding": "40px 20px"
      },
      "ProductGrid": {
        "display": "grid",
        "columns": 2,
        "gap": "12px"
      },
      "ProductCard": {
        "background": "#F5F5F7",
        "border_radius": "14px",
        "padding": "16px",
        "image": {
          "source": "variant_color[0].image_link",
          "width": "100%",
          "aspect_ratio": "1:1",
          "object_fit": "contain"
        }
      },
      "FilterTab": {
        "display": "horizontal-scroll",
        "gap": "8px",
        "border_radius": "20px",
        "padding": "9px 14px"
      },
      "PrimaryButton": {
        "background": "#0071E3",
        "color": "#FFFFFF",
        "border_radius": "10px",
        "padding": "13px"
      },
      "BottomNav": {
        "background": "#FFFFFF",
        "border_top": "1px solid #EEEEEE",
        "items": 3
      },
      "CartDrawer": {
        "position": "right",
        "width": "88%",
        "max_width": "420px",
        "background": "#FFFFFF"
      }
    },
    "rules": {
      "mobile_only": true,
      "desktop_layout": false,
      "horizontal_overflow": "avoid",
      "main_scroll": "vertical",
      "product_image_source": "variant_color[0].image_link",
      "product_image_ratio": "1:1"
    }
  }
}
